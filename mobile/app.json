{
  "expo": {
    "name": "envelo",
    "slug": "envelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "envelo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": { "UIBackgroundModes": ["audio"] }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEE3E2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.millionaireclub.envelo",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@cloudflare/react-native-webrtc",
      "@cloudflare/realtimekit-react-native",
      "./plugins/with-calling",
      "./plugins/with-conversation-notifications",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D39A86",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#242326"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Envelo uses your camera when you enable video in a call or take a photo to share.",
          "photosPermission": "Envelo needs access to your photos so you can set a profile picture and share images.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Envelo needs access to your recent photos so you can preview and attach them in conversations.",
          "savePhotosPermission": "Envelo can save photos to your library when you choose to do so.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Envelo uses your current location only when you choose to share it in a conversation."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Envelo needs access to contacts only when you choose a contact to share."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Envelo uses your microphone for calls and when you record a voice message."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb7310ac-bf45-475f-b236-8c49b770808a"
      }
    },
    "owner": "millionaire-club"
  }
}
