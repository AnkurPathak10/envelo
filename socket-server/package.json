{
  "name": "envelo-socket-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate --generator socketClient --schema=../backend/prisma/schema.prisma",
    "generate:all": "prisma generate --schema=../backend/prisma/schema.prisma",
    "dev": "npm run generate && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run generate && tsc && node scripts/copy-generated-client.cjs",
    "start": "node dist/index.js",
    "verify:message-flow": "ts-node-dev --transpile-only scripts/verify-message-flow.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "prettier": "^3.9.7",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
